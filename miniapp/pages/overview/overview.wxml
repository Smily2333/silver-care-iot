<!--设备概览页-->
<view class="page" wx:if="{{!loading}}">
  <view class="demo-banner" wx:if="{{demo}}">
    <text class="demo-banner-title">匿名示例 · 只读体验</text>
    <text class="demo-banner-text">以下内容为动态生成的演示数据，不对应真实人员或设备</text>
  </view>
  <view class="load-error" wx:if="{{errorMsg}}">
    <text class="load-error-title">暂时无法加载设备数据</text>
    <text class="load-error-text">{{errorMsg}}</text>
    <button class="retry-button" bindtap="retryLoad">重新加载</button>
  </view>
  <block wx:if="{{!errorMsg}}">
  <!-- 顶部渐变头部 -->
  <view class="page-header">
    <view class="header-top">
      <view class="device-name-row">
        <block wx:if="{{!editing}}">
          <text class="device-name">{{displayName}}</text>
          <text class="edit-icon" bindtap="startEdit" wx:if="{{!demo}}">编辑</text>
        </block>
        <block wx:else>
          <input class="name-input" value="{{editValue}}" bindinput="onEditInput"
                 placeholder="输入老人姓名" maxlength="64" focus />
          <text class="{{canSave && !saving ? 'confirm-btn' : 'confirm-btn confirm-btn-disabled'}}"
                bindtap="saveOwnerName">✓</text>
        </block>
        <text class="{{data.device.status === 'ONLINE' ? 'tag-online' : 'tag-offline'}}">
          {{data.device.status === 'ONLINE' ? '在线' : '离线'}}
        </text>
      </view>
      <text class="device-model">{{data.device.model || '智能健康手表'}}</text>
      <text class="last-heartbeat">设备最后在线时间：{{lastOnline}}</text>
    </view>

    <!-- 电量 + 步数 行 -->
    <view class="header-stats">
      <view class="header-stat-item">
        <view class="stat-icon-wrap battery-icon-wrap">
          <text class="stat-icon">🔋</text>
        </view>
        <text class="stat-value">{{data.device.batteryLevel != null ? data.device.batteryLevel + '%' : '--'}}</text>
        <text class="stat-label">电量</text>
      </view>
      <view class="stat-divider"></view>
      <view class="header-stat-item">
        <view class="stat-icon-wrap steps-icon-wrap">
          <text class="stat-icon">👟</text>
        </view>
        <text class="stat-value">{{data.device.stepCount != null ? data.device.stepCount : '--'}}</text>
        <text class="stat-label">每日步数</text>
      </view>
    </view>
  </view>

  <!-- 内容区 -->
  <view class="content-area">
    <view wx:if="{{hasNewAlert}}" class="alert-banner" bindtap="goAlerts">
      <view class="alert-banner-icon">!</view>
      <view class="alert-banner-main">
        <text class="alert-banner-title">设备上报疑似跌倒事件</text>
        <text class="alert-banner-time">{{latestAlertTime}}</text>
      </view>
      <text class="alert-banner-arrow">›</text>
    </view>

    <!-- 健康指标卡片 -->
    <view wx:if="{{data.latestHealth}}" class="card health-card">
      <view class="card-header-row">
        <text class="section-title">健康数据</text>
        <text class="measured-at">{{measuredAt}}</text>
      </view>
      <view class="health-metrics">
        <!-- 心率 -->
        <view class="metric-item">
          <view class="metric-ring heart-ring">
            <text class="metric-main-val">{{healthMetrics.heartRate != null ? healthMetrics.heartRate : '--'}}</text>
          </view>
          <text class="metric-label">心率</text>
          <text class="metric-unit">bpm</text>
          <text class="metric-time">{{healthMetrics.heartTime}}</text>
        </view>
        <!-- 血压 -->
        <view class="metric-item">
          <view class="metric-ring bp-ring">
            <text class="metric-bp-val">{{healthMetrics.systolic != null ? healthMetrics.systolic : '--'}}</text>
            <text class="metric-bp-sep">/</text>
            <text class="metric-bp-val">{{healthMetrics.diastolic != null ? healthMetrics.diastolic : '--'}}</text>
          </view>
          <text class="metric-label">血压</text>
          <text class="metric-unit">mmHg</text>
          <text class="metric-time">{{healthMetrics.pressureTime}}</text>
        </view>
        <!-- 体温 -->
        <view class="metric-item">
          <view class="metric-ring temp-ring">
            <text class="metric-main-val">{{healthMetrics.temperature != null ? healthMetrics.temperature : '--'}}</text>
          </view>
          <text class="metric-label">体温</text>
          <text class="metric-unit">℃</text>
          <text class="metric-time">{{healthMetrics.temperatureTime}}</text>
        </view>
      </view>
    </view>
    <view class="card empty-health-card" wx:else>
      <text class="empty-icon">💓</text>
      <text class="empty-text">暂无健康数据</text>
    </view>

    <!-- 位置卡片 -->
    <view class="card location-card" wx:if="{{data.latestLocation}}">
      <view class="card-header-row">
        <text class="section-title">最新位置</text>
        <text class="measured-at">{{locatedAt}}</text>
      </view>
      <view class="location-row">
        <view class="location-pin">
          <text class="location-pin-icon">📍</text>
        </view>
        <view class="location-coords">
          <text class="coord-text">纬度 {{data.latestLocation.latitude}}</text>
          <text class="coord-text">经度 {{data.latestLocation.longitude}}</text>
        </view>
      </view>
    </view>

    <!-- 导航入口 -->
    <view class="nav-grid">
      <view class="nav-card" bindtap="goHealth">
        <view class="nav-card-icon health-nav-icon">
          <text>❤️</text>
        </view>
        <text class="nav-card-label">健康趋势</text>
        <text class="nav-card-sub">查看设备测量记录</text>
      </view>
      <view class="nav-card" bindtap="goLocation">
        <view class="nav-card-icon location-nav-icon">
          <text>🗺</text>
        </view>
        <text class="nav-card-label">位置记录</text>
        <text class="nav-card-sub">查看设备定位记录</text>
      </view>
      <view class="nav-card" bindtap="goAlerts">
        <view class="nav-card-icon alert-nav-icon">
          <text>!</text>
        </view>
        <text class="nav-card-label">安全事件</text>
        <text class="nav-card-sub">查看疑似跌倒记录</text>
      </view>
    </view>
    <view class="overview-disclaimer">
      设备数据仅供日常照护参考，不作为医疗诊断、治疗或紧急救援依据。
    </view>
  </view>
  </block>
</view>

<view class="loading-wrap" wx:if="{{loading}}">
  <text class="loading-icon">⏳</text>
  <text>加载中...</text>
</view>
