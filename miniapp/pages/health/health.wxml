<!--健康数据页-->
<view class="page">
  <view class="demo-banner" wx:if="{{demo}}">
    <text class="demo-banner-title">匿名示例 · 只读体验</text>
    <text class="demo-banner-text">以下为动态生成的演示数据，不代表真实测量结果</text>
  </view>
  <view wx:if="{{loading}}" class="loading-wrap">
    <text class="loading-icon">⏳</text>
    <text>加载中...</text>
  </view>

  <view wx:else>
    <view class="load-error card" wx:if="{{errorMsg}}">
      <text class="load-error-title">健康记录加载失败</text>
      <text class="load-error-text">{{errorMsg}}</text>
      <button class="retry-button" bindtap="retryLoad">重新加载</button>
    </view>
    <block wx:if="{{!errorMsg}}">
    <!-- 顶部渐变头部 -->
    <view class="page-header">
      <text class="header-title">健康趋势</text>
      <text class="header-sub">智能手表上传的设备测量记录</text>

      <!-- 最新数据大展示 -->
      <view class="latest-metrics" wx:if="{{records.length > 0}}">
        <view class="metric-big-item heart-item">
          <view class="metric-big-icon">❤️</view>
          <text class="metric-big-val">{{latestMetrics.heartRate != null ? latestMetrics.heartRate : '--'}}</text>
          <text class="metric-big-unit">bpm 心率</text>
        </view>
        <view class="metric-big-item bp-item">
          <view class="metric-big-icon">💉</view>
          <text class="metric-big-val bp-val">
            {{latestMetrics.systolic != null ? latestMetrics.systolic + '/' + latestMetrics.diastolic : '--'}}
          </text>
          <text class="metric-big-unit">mmHg 血压</text>
        </view>
        <view class="metric-big-item temp-item">
          <view class="metric-big-icon">🌡</view>
          <text class="metric-big-val">{{latestMetrics.temperature != null ? latestMetrics.temperature : '--'}}</text>
          <text class="metric-big-unit">℃ 体温</text>
        </view>
      </view>
    </view>

    <!-- 内容区 -->
    <view class="content-area">
      <!-- 历史记录 -->
      <view class="card">
        <text class="section-title">历史记录（{{records.length}}条）</text>
        <view wx:if="{{records.length === 0}}" class="empty-tip">
          <text class="empty-text">暂无数据</text>
        </view>
        <view
          wx:for="{{records}}"
          wx:key="id"
          class="record-row"
        >
          <view class="record-time-row">
            <view class="record-dot"></view>
            <text class="record-time">{{item.measuredAtStr}}</text>
          </view>
          <view class="record-tags">
            <view wx:if="{{item.heartRate != null}}" class="record-tag heart-tag">
              <text class="tag-icon">❤</text>
              <text>{{item.heartRate}} bpm</text>
            </view>
            <view wx:if="{{item.systolicPressure != null}}" class="record-tag bp-tag">
              <text class="tag-icon">💧</text>
              <text>{{item.systolicPressure}}/{{item.diastolicPressure}}</text>
            </view>
            <view wx:if="{{item.bodyTemperature != null}}" class="record-tag temp-tag">
              <text class="tag-icon">🌡</text>
              <text>{{item.bodyTemperature}}℃</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="page-disclaimer">数据仅供日常照护参考，不作为医疗诊断或治疗依据。</view>
    </block>
  </view>
</view>
