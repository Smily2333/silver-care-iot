<view class="page">
  <view class="content">
    <block wx:if="{{hasDevices}}">
      <view class="section-heading-row">
        <text class="section-label">正在守护</text>
        <text class="add-device" bindtap="showBinding">＋ 添加设备</text>
      </view>
      <view class="care-card" bindtap="openPrimary">
        <view class="care-card-head">
          <view class="care-avatar">{{primarySummary.displayInitial}}</view>
          <view class="care-main">
            <view class="care-name-row">
              <text class="care-name">{{primarySummary.displayName}}</text>
              <text class="status-tag {{primarySummary.online ? 'online' : 'offline'}}">{{primarySummary.statusText}}</text>
            </view>
            <text class="device-line">智能健康手表 · {{primarySummary.deviceNo}}</text>
            <text class="sync-line">{{primarySummary.lastSyncText}}</text>
          </view>
          <text class="card-arrow">›</text>
        </view>
        <view class="device-stats">
          <view class="device-stat">
            <text class="stat-value">{{primarySummary.batteryText}}</text>
            <text class="stat-label">电量</text>
          </view>
          <view class="stat-divider"></view>
          <view class="device-stat">
            <text class="stat-value">{{primarySummary.stepText}}</text>
            <text class="stat-label">今日步数</text>
          </view>
        </view>
        <view class="summary-error" wx:if="{{summaryError}}" catchtap="retrySummary">
          <text>{{summaryError}}</text>
          <text class="retry-link">重新同步</text>
        </view>
        <view class="summary-loading" wx:if="{{summaryLoading && !summaryError}}">正在同步最新状态…</view>
      </view>

      <view class="alert-strip" wx:if="{{primarySummary.hasNewAlert}}" bindtap="goPrimaryAlerts">
        <view class="alert-symbol">!</view>
        <view class="alert-copy">
          <text class="alert-title">设备上报疑似跌倒事件</text>
          <text class="alert-time">{{primarySummary.alertHint}} · 请及时确认</text>
        </view>
        <text class="alert-arrow">›</text>
      </view>

      <view class="quick-grid">
        <view class="quick-card" bindtap="goPrimaryHealth">
          <view class="quick-icon health-icon">心</view>
          <text class="quick-name">健康趋势</text>
          <text class="quick-value">{{primarySummary.healthValue}}</text>
          <text class="quick-hint">{{primarySummary.healthHint}}</text>
        </view>
        <view class="quick-card" bindtap="goPrimaryLocation">
          <view class="quick-icon location-icon">位</view>
          <text class="quick-name">位置记录</text>
          <text class="quick-value">{{primarySummary.locationValue}}</text>
          <text class="quick-hint">{{primarySummary.locationHint}}</text>
        </view>
        <view class="quick-card {{primarySummary.hasNewAlert ? 'quick-alert-active' : ''}}" bindtap="goPrimaryAlerts">
          <view class="quick-icon alert-icon">!</view>
          <text class="quick-name">安全事件</text>
          <text class="quick-value">{{primarySummary.alertValue}}</text>
          <text class="quick-hint">{{primarySummary.alertHint}}</text>
        </view>
      </view>

      <view class="other-section" wx:if="{{otherRecent.length > 0}}">
        <text class="section-label">其他守护设备</text>
        <view class="other-list">
          <view class="other-item" wx:for="{{otherRecent}}" wx:key="deviceNo" bindtap="onRecentTap" data-no="{{item.deviceNo}}">
            <view class="other-avatar">{{item.displayInitial}}</view>
            <view class="other-copy">
              <text class="other-name">{{item.displayName}}</text>
              <text class="other-device">设备 {{item.deviceNo}}</text>
            </view>
            <text class="other-arrow">›</text>
          </view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="welcome-card">
        <view class="welcome-illustration">
          <view class="watch-face">心</view>
          <view class="watch-band watch-band-top"></view>
          <view class="watch-band watch-band-bottom"></view>
        </view>
        <text class="welcome-title">连接家人的智能手表</text>
        <text class="welcome-desc">查看设备上传的健康趋势、位置记录和疑似跌倒事件，方便家人进行日常照护。</text>
        <button class="bind-primary" bindtap="showBinding">绑定智能手表</button>
        <text class="demo-entry" bindtap="enterDemo">还没有设备？先看看怎么使用</text>
      </view>
      <view class="first-use-features">
        <view class="first-feature"><text class="first-icon health-icon">心</text><text>健康趋势</text></view>
        <view class="first-feature"><text class="first-icon location-icon">位</text><text>位置记录</text></view>
        <view class="first-feature"><text class="first-icon alert-icon">!</text><text>安全事件</text></view>
      </view>
    </block>

    <view id="device-binding" class="binding-card" wx:if="{{bindingExpanded}}">
      <view class="binding-head">
        <view>
          <text class="binding-title">绑定智能手表</text>
          <text class="binding-sub">输入手表背面或包装上的设备编号，每个微信最多绑定4台</text>
        </view>
        <text class="close-binding" bindtap="cancelBinding">关闭</text>
      </view>
      <view class="device-input-row">
        <input
          class="device-input"
          placeholder="请输入设备编号"
          placeholder-class="device-placeholder"
          value="{{deviceNo}}"
          focus="{{inputFocus}}"
          maxlength="64"
          bindinput="onInput"
          bindconfirm="onQuery"
          confirm-type="go"
        />
        <button class="query-button" bindtap="onQuery" loading="{{loading}}" disabled="{{loading}}">继续</button>
      </view>
      <view class="error-box" wx:if="{{errorMsg}}"><text class="error-icon">!</text><text>{{errorMsg}}</text></view>
      <view class="binding-foot">
        <text>绑定前请确认已获得佩戴人授权</text>
        <text class="guide-link" bindtap="openGuide">查看说明</text>
      </view>
    </view>

    <view class="small-demo-card" wx:if="{{hasDevices}}" bindtap="enterDemo">
      <view>
        <text class="small-demo-title">想先了解其他功能？</text>
        <text class="small-demo-desc">查看匿名示例，不影响真实设备</text>
      </view>
      <text class="small-demo-arrow">›</text>
    </view>

    <view class="footer-note">设备数据仅供日常照护参考，不作为医疗诊断、治疗或紧急救援依据。</view>
    <view class="footer-links">
      <text bindtap="openGuide">使用说明</text>
      <text>·</text>
      <text bindtap="openPrivacy">隐私说明</text>
      <block wx:if="{{hasDevices}}"><text>·</text><text bindtap="clearRecent">清除本机记录</text></block>
    </view>
  </view>
</view>
