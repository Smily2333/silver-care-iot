page { background: #f3f6f8; }
.page { min-height: 100vh; color: #1c293a; }
.privacy-header { padding: 64rpx 36rpx 70rpx; background: linear-gradient(145deg, #102b46, #1c6b5c); }
.privacy-title, .privacy-desc { display: block; }
.privacy-title { color: #fff; font-size: 43rpx; font-weight: 750; }
.privacy-desc { margin-top: 18rpx; color: rgba(255,255,255,0.68); font-size: 24rpx; line-height: 1.7; }
.content { padding: 28rpx 24rpx 60rpx; }
.privacy-card, .demo-note { margin-bottom: 24rpx; padding: 32rpx; border-radius: 22rpx; background: #fff; box-shadow: 0 5rpx 20rpx rgba(20,48,67,0.05); }
.card-title { display: block; margin-bottom: 14rpx; color: #1c293a; font-size: 30rpx; font-weight: 700; }
.data-item { padding: 20rpx 0; border-bottom: 1rpx solid #edf0f2; }
.data-item:last-child { border-bottom: none; padding-bottom: 0; }
.data-name, .data-purpose { display: block; }
.data-name { color: #286c5a; font-size: 25rpx; font-weight: 650; }
.data-purpose, .paragraph { margin-top: 8rpx; color: #74818e; font-size: 23rpx; line-height: 1.72; }
.paragraph { display: block; margin-top: 16rpx; }
.note { padding: 18rpx 20rpx; border-radius: 14rpx; background: #fff8f4; color: #8f6552; }
.contact-row, .policy-link { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 22rpx; padding: 22rpx; border-radius: 15rpx; background: #f6f9f8; }
.contact-label, .contact-value, .policy-link-title, .policy-link-url { display: block; }
.contact-label, .policy-link-title { color: #34453f; font-size: 23rpx; font-weight: 650; }
.contact-value, .policy-link-url { margin-top: 6rpx; color: #26715c; font-size: 22rpx; word-break: break-all; }
.copy-label { flex-shrink: 0; color: #71827b; font-size: 20rpx; }
.demo-note { border: 1rpx solid #dcebe4; background: #f6fbf8; }
.demo-note-title, .demo-note-text { display: block; }
.demo-note-title { color: #236b57; font-size: 26rpx; font-weight: 700; }
.demo-note-text { margin-top: 10rpx; color: #64776f; font-size: 22rpx; line-height: 1.7; }
.policy-link { margin: 0 0 20rpx; padding: 26rpx 28rpx; background: #fff; box-shadow: 0 5rpx 20rpx rgba(20,48,67,0.05); }
.official-button { height: 86rpx; line-height: 86rpx; border-radius: 18rpx; background: #1d6b59; color: #fff; font-size: 26rpx; }
.official-button::after { border: none; }
