# Copy to /etc/silver-care-nominatim/nominatim.env, chmod 600, and never commit it.
# The data directory must be on a dedicated SSD-backed filesystem with at least 150 GiB free.
NOMINATIM_DATA_DIR=/var/lib/silver-care-nominatim
NOMINATIM_HTTP_PORT=7070
OSM_PBF_FILE=beijing-tianjin-hebei-latest.osm.pbf
NOMINATIM_PASSWORD=replace-with-a-generated-local-database-password

# Conservative defaults for a dedicated 8 vCPU / 32 GiB RAM host.
NOMINATIM_THREADS=4
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_WORK_MEM=128MB
POSTGRES_MAINTENANCE_WORK_MEM=1GB
NOMINATIM_SHM_SIZE=1gb
