# Copy to /etc/silver-care-iot/backend-prod.env and chmod 600.
SPRING_PROFILES_ACTIVE=prod
SILVER_CARE_PROD_DB_URL=jdbc:mysql://127.0.0.1:3306/silver_care?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
SILVER_CARE_PROD_DB_USERNAME=silvercare
SILVER_CARE_PROD_DB_PASSWORD=replace-with-a-strong-password
SILVER_CARE_PROD_ADMIN_USERNAME=admin
SILVER_CARE_PROD_ADMIN_PASSWORD=replace-with-a-strong-password
SILVER_CARE_PROD_GATEWAY_ENABLED=true
SILVER_CARE_PROD_GATEWAY_PORT=9001
WECHAT_MINIAPP_PROD_APPID=wx0d83544c7be6bc73
WECHAT_MINIAPP_PROD_APP_SECRET=replace-with-the-secret-from-wechat
WECHAT_MINIAPP_PROD_SESSION_TTL_DAYS=30
SILVER_CARE_PROD_GEOCODING_ENABLED=false
SILVER_CARE_PROD_NOMINATIM_BASE_URL=http://127.0.0.1:7070
SILVER_CARE_PROD_GEOCODING_BACKFILL_LIMIT=100
# Keep empty until each command is verified against a real device.
SILVER_CARE_PROD_CONFIRMED_DEVICE_ACTIONS=
SILVER_CARE_PROD_ALLOW_HEALTH_WITHOUT_WEAR_STATUS=false
